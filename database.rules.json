{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        "host": {
          ".write": "auth != null && !data.exists()"
        },
        "status": {
          ".write": "auth != null && data.val() === 'waiting' && newData.val() === 'filling' && root.child('rooms').child($roomCode).child('host').val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "fillDeadline": { ".write": false },
        "calledNumbers": { ".write": false },
        "officialSequence": { ".write": false },
        "currentIndex": { ".write": false },
        "winnerUid": { ".write": false },
        "winningPattern": { ".write": false },
        "claims": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomCode).child('status').val() === 'calling'"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomCode).child('status').val() === 'waiting'",
            ".validate": "newData.hasChildren(['name','ready','cardLocked']) && newData.child('name').isString() && newData.child('ready').isBoolean() && newData.child('cardLocked').isBoolean()",
            "card": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomCode).child('status').val() === 'filling' && root.child('rooms').child($roomCode).child('players').child($uid).child('cardLocked').val() !== true"
            },
            "cardLocked": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomCode).child('status').val() === 'filling'"
            },
            "marked": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomCode).child('status').val() === 'calling'"
            },
            "name": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomCode).child('status').val() === 'waiting'"
            },
            "ready": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomCode).child('status').val() === 'waiting'"
            }
          }
        }
      }
    },
    "privateSequences": {
      "$roomCode": {
        ".read": false,
        ".write": false
      }
    }
  }
}
