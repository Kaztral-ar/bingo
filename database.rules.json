{
  "rules": {
    "rooms": {
      "$roomCode": {
        // Anyone signed in (anonymous auth is fine) can read a room to join/spectate it.
        ".read": "auth != null",

        "host": {
          ".write": "auth != null && !data.exists()"
        },
        "status": {
          // Only the host can move the room out of "waiting"; the calling-phase
          // and finished transitions are written exclusively by Cloud Functions
          // using the Admin SDK, which bypasses these rules entirely.
          ".write": "auth != null && root.child('rooms').child($roomCode).child('host').val() === auth.uid"
        },
        "fillDeadline": {
          ".write": "auth != null && root.child('rooms').child($roomCode).child('host').val() === auth.uid"
        },
        "calledNumbers": { ".write": false },
        "currentIndex": { ".write": false },
        "winnerUid": { ".write": false },
        "winningPattern": { ".write": false },
        "claims": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "card": {
              // A player may only write their own card while the room is still filling,
              // and never again once it's locked.
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomCode).child('status').val() === 'filling' && root.child('rooms').child($roomCode).child('players').child($uid).child('cardLocked').val() !== true"
            },
            "marked": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomCode).child('status').val() === 'calling'"
            }
          }
        }
      }
    }
  }
}
