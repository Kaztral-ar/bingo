<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ROOM CODE"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textRoomCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="------"
        android:textColor="@color/accent_gold"
        android:textSize="48sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share this code with your friend."
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/textLobbyStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Waiting for Player 2…"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnStartGame"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="START GAME"
        android:enabled="false"
        android:textColor="@color/bg_deep"
        android:backgroundTint="@color/accent_mint" />

</LinearLayout>
