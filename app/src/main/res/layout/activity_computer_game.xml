<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BINGO 1–25"
        android:textColor="@color/accent_gold"
        android:textStyle="bold"
        android:textSize="20sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/textStatusLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BOTH PLAYERS — FILL YOUR CARDS"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/textBigNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1"
        android:textColor="@color/accent_gold"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/textTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Card Time: 2:00"
        android:textColor="@color/accent_coral"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <HorizontalScrollView
        android:id="@+id/calledScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/calledNumbersRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="YOU"
            android:textColor="@color/accent_mint"
            android:textStyle="bold"
            android:gravity="center" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="COMPUTER"
            android:textColor="@color/accent_coral"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/bingoGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="5"
        android:rowCount="5"
        android:padding="@dimen/grid_padding" />

    <TextView
        android:id="@+id/textFooterStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fill your card while the computer prepares its card."
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnCallNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CALL NUMBER"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="4dp" />

</LinearLayout>
